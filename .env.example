NODE_ENV=development
APP_PORT=3600
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventmitra
DB_SSL=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set CORS_ORIGINS=* only for local testing. Production should list trusted origins.

# Razorpay Standard Checkout: keep secrets on the server. Configure automatic capture in Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Booking amounts are INR. Tax is explicitly configured in basis points (0 = no configured tax).
BOOKING_TAX_BPS=0
BOOKING_TIME_ZONE=Asia/Kolkata
BOOKING_PAYMENT_WINDOW_MINUTES=30
# Empty = notify every active super admin by email. Comma-separated inboxes override admin email targets.
BOOKING_ADMIN_EMAILS=

# Gmail works with smtp.gmail.com:465, secure=true, and an app password or SMTP-capable account.
# Other SMTP providers can use their own host/port. Never put these credentials in Postman/frontend.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Firebase HTTP v1 uses Google's Application Default Credentials / this private service-account path.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Shared authenticated S3 uploads. Use a private existing bucket and least-privilege IAM credentials/role.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary AWS credentials. Standard AWS profiles / IAM roles also work.
AWS_SESSION_TOKEN=
