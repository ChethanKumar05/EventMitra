{
  "info": {
    "name": "EventMitra - Owner API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Signup, test OTP verification, login/logout, and password recovery. Signup first creates a pending owner; names must be unique. Test OTP is 1111 and real email/SMS delivery is not connected. OTPs are disabled in production. Reset uses a verified password-reset token, not a general verification token. Run signup once; use existing-account auth folders separately afterward."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 - Signup (run once per account)",
      "item": [
        {
          "name": "Signup owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/owner/auth/signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_name\": \"{{owner_name}}\",\n  \"owner_phone_number\": \"{{owner_phone_number}}\",\n  \"country_code\": \"{{country_code}}\",\n  \"email\": \"{{owner_email}}\",\n  \"password\": \"{{owner_password}}\",\n  \"alternative_number\": null,\n  \"profile_image\": null,\n  \"alternative_email\": null,\n  \"whatsapp_number\": null,\n  \"gender\": \"m\",\n  \"doc_type\": \"passport\",\n  \"doc_number\": \"REPLACE_WITH_DOCUMENT_NUMBER\",\n  \"doc_image\": \"/uploads/owner-document.jpg\",\n  \"pin_code\": \"560001\",\n  \"state\": \"Karnataka\",\n  \"city\": \"Bengaluru\",\n  \"area\": \"Indiranagar\",\n  \"lat\": 12.9716,\n  \"long\": 77.5946,\n  \"address\": \"REPLACE_WITH_ADDRESS\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201',function(){pm.response.to.have.status(201);});",
                  "pm.test('Success',function(){pm.expect(pm.response.json().status).to.eql(true);});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Verify signup email",
      "item": [
        {
          "name": "Send email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/owner/auth/send-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"email\",\n  \"email\": \"{{owner_email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',function(){pm.response.to.have.status(200);});",
                  "pm.test('Success',function(){pm.expect(pm.response.json().status).to.eql(true);});",
                  "if(pm.response.code===200)pm.collectionVariables.set('email_otp_token',pm.response.json().data.otp_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/owner/auth/verify-otp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"1111\",\n  \"otp_token\": \"{{email_otp_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',function(){pm.response.to.have.status(200);});",
                  "pm.test('Success',function(){pm.expect(pm.response.json().status).to.eql(true);});"
                ]
              }
            }
          ]
        }
      ]
    },
