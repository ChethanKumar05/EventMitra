{
  "name": "eventmitra-backend-ts",
  "version": "1.0.0",
  "private": true,
  "description": "eventmitra Node.js + TypeScript + PostgreSQL raw SQL backend starter",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrations/runMigrations.ts",
    "migrate:compiled": "node dist/migrations/runMigrations.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests",
    "admin:bootstrap": "tsx src/scripts/createSuperAdmin.ts",
    "test:integration": "npm run build && node --test tests/security.integration.test.cjs",
    "test:integration:local": "npm run build && node tests/run-local-integration.cjs",
    "admin:bootstrap:sql": "tsx src/scripts/generateSuperAdminSql.ts",
    "test:owner:integration": "npm run build && node --test tests/owner-auth.integration.test.cjs",
    "test:owner:integration:local": "npm run build && node tests/run-local-integration.cjs owner"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
